<?xml version="1.0" encoding="UTF-8"?>
<!-- WSO2 Micro Integrator 4.2.0 - Energy API Endpoint -->
<endpoint name="EnergyAPIEndpoint" xmlns="http://ws.apache.org/ns/synapse">
    <address uri="http://localhost:8000/energy">
        <timeout>
            <duration>10000</duration>
            <responseAction>fault</responseAction>
        </timeout>
        <suspendOnFailure>
            <initialDuration>1000</initialDuration>
            <progressionFactor>2.0</progressionFactor>
            <maximumDuration>30000</maximumDuration>
        </suspendOnFailure>
    </address>
</endpoint>

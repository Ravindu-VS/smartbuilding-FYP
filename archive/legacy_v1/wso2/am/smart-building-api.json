{
  "openapi": "3.0.3",
  "info": {
    "title": "Smart Building AIoT Enterprise API",
    "description": "Enterprise API Gateway for the Edge Intelligence-Driven Digital Twin Smart Building Platform.\n\nIntegrates IoT sensor ingestion, AI/ML inference, PPO reinforcement learning, energy optimization, predictive maintenance, and RAG building assistant.\n\n## Architecture\n```\nESP32 → MQTT → WSO2 MI → FastAPI → AI/ML → Digital Twin → Dashboard\n```\n\n## Authentication\nJWT Bearer tokens via `/auth/token` endpoint.\nDemo users: admin/admin123, operator/operator123, viewer/viewer123",
    "version": "2.0.0",
    "contact": {
      "name": "RMRVS Rathnayaka",
      "email": "40-bce-0011@kdu.ac.lk"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "FastAPI Backend (Direct)"
    },
    {
      "url": "https://localhost:8243/smart-building/v2",
      "description": "WSO2 API Manager Gateway"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/energy/current": {
      "get": {
        "tags": ["Energy"],
        "summary": "Current energy consumption",
        "description": "Real-time energy consumption snapshot across the entire building",
        "operationId": "getCurrentEnergy",
        "responses": {
          "200": {
            "description": "Energy consumption data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EnergyCurrentResponse" }
              }
            }
          }
        }
      }
    },
    "/energy/history": {
      "get": {
        "tags": ["Energy"],
        "summary": "Historical energy data",
        "operationId": "getEnergyHistory",
        "parameters": [
          {
            "name": "hours",
            "in": "query",
            "schema": { "type": "number", "default": 24, "minimum": 1, "maximum": 720 },
            "description": "Hours of history to retrieve"
          }
        ],
        "responses": {
          "200": {
            "description": "Historical energy entries"
          }
        }
      }
    },
    "/energy/prediction": {
      "get": {
        "tags": ["Energy"],
        "summary": "24-hour energy forecast",
        "description": "AI-powered energy prediction using Random Forest model",
        "operationId": "getEnergyPrediction",
        "responses": {
          "200": {
            "description": "24-hour forecast",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EnergyPredictionResponse" }
              }
            }
          }
        }
      }
    },
    "/building/status": {
      "get": {
        "tags": ["Building"],
        "summary": "Full building status",
        "description": "Complete building state including all floors, rooms, and sensors",
        "operationId": "getBuildingStatus",
        "responses": {
          "200": {
            "description": "Building status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BuildingStatusResponse" }
              }
            }
          }
        }
      }
    },
    "/building/digital-twin": {
      "get": {
        "tags": ["Building"],
        "summary": "Digital twin state",
        "description": "Compact state payload optimized for 3D visualization",
        "operationId": "getDigitalTwinState",
        "responses": {
          "200": { "description": "Digital twin room states" }
        }
      }
    },
    "/sensors/ingest": {
      "post": {
        "tags": ["Sensors"],
        "summary": "Ingest sensor telemetry",
        "description": "Receive sensor data from ESP32 via WSO2 MI or direct POST",
        "operationId": "ingestSensorData",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SensorIngestRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Telemetry ingested",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SensorIngestResponse" }
              }
            }
          }
        }
      }
    },
    "/optimization/action": {
      "post": {
        "tags": ["Optimization"],
        "summary": "Trigger AI optimization",
        "description": "Compute optimal HVAC and lighting actions using PPO RL controller",
        "operationId": "triggerOptimization",
        "responses": {
          "200": {
            "description": "Optimization actions computed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OptimizationResponse" }
              }
            }
          }
        }
      }
    },
    "/optimization/agent/decide": {
      "post": {
        "tags": ["Optimization"],
        "summary": "Autonomous energy agent decision",
        "description": "AI agent interprets building conditions and makes energy decisions",
        "operationId": "agentDecide",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AgentDecisionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent decision",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AgentDecisionResponse" }
              }
            }
          }
        }
      }
    },
    "/ai/assistant": {
      "post": {
        "tags": ["AI"],
        "summary": "Building Knowledge Assistant",
        "description": "RAG-powered AI assistant for building queries",
        "operationId": "queryAssistant",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AssistantQuery" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assistant response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AssistantResponse" }
              }
            }
          }
        }
      }
    },
    "/ai/anomalies": {
      "get": {
        "tags": ["AI"],
        "summary": "Predictive maintenance anomalies",
        "description": "Detect abnormal energy usage and equipment problems",
        "operationId": "getAnomalies",
        "responses": {
          "200": { "description": "Anomaly list" }
        }
      }
    },
    "/auth/token": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Generate JWT token",
        "description": "Generate access token for API authentication",
        "operationId": "generateToken",
        "security": [],
        "parameters": [
          { "name": "username", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "password", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "JWT token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "SensorIngestRequest": {
        "type": "object",
        "required": ["telemetry"],
        "properties": {
          "topic": { "type": "string", "example": "building/A/floor/1/room/101/sensor" },
          "room_id": { "type": "string", "example": "f1_room_101" },
          "telemetry": {
            "type": "object",
            "properties": {
              "temperature": { "type": "number", "example": 24.5 },
              "humidity": { "type": "number", "example": 55.0 },
              "co2": { "type": "number", "example": 450.0 },
              "lux": { "type": "number", "example": 380.0 }
            }
          },
          "source": { "type": "string", "default": "hardware" }
        }
      },
      "SensorIngestResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "room_id": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "EnergyCurrentResponse": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "total_power_watts": { "type": "number" },
          "hvac_power_watts": { "type": "number" },
          "lighting_power_watts": { "type": "number" },
          "percentage_saved": { "type": "number" }
        }
      },
      "EnergyPredictionResponse": {
        "type": "object",
        "properties": {
          "predictions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "hour": { "type": "integer" },
                "predicted_wh": { "type": "number" }
              }
            }
          },
          "model_type": { "type": "string" }
        }
      },
      "BuildingStatusResponse": {
        "type": "object",
        "properties": {
          "building_name": { "type": "string" },
          "total_floors": { "type": "integer" },
          "total_rooms": { "type": "integer" },
          "total_power_watts": { "type": "number" }
        }
      },
      "OptimizationResponse": {
        "type": "object",
        "properties": {
          "actions": { "type": "array" },
          "controller_type": { "type": "string" },
          "total_estimated_savings_percent": { "type": "number" }
        }
      },
      "AgentDecisionRequest": {
        "type": "object",
        "required": ["temperature", "occupancy", "energy_price"],
        "properties": {
          "temperature": { "type": "number", "example": 29.0 },
          "occupancy": { "type": "string", "enum": ["low", "medium", "high"] },
          "energy_price": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      },
      "AgentDecisionResponse": {
        "type": "object",
        "properties": {
          "decision": { "type": "string" },
          "reasoning": { "type": "string" },
          "estimated_savings": { "type": "number" }
        }
      },
      "AssistantQuery": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "example": "What is the current energy consumption?" }
        }
      },
      "AssistantResponse": {
        "type": "object",
        "properties": {
          "response": { "type": "string" },
          "llm_used": { "type": "string" }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "token_type": { "type": "string", "default": "bearer" },
          "expires_in": { "type": "integer" }
        }
      }
    }
  }
}

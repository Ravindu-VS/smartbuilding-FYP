/*
 * WSO2 Streaming Integrator 7.0.0
 * Occupancy Pattern Siddhi Application
 *
 * Aggregates occupancy patterns over time windows.
 * Feeds pattern data to the RL agent for adaptive learning.
 *
 * Input:  OccupancyEventStream
 * Output: OccupancyPatternStream (hourly patterns)
 *         OccupancyInsightStream (daily summaries)
 */

@App:name("OccupancyPatternApp")
@App:description("Occupancy pattern analysis for adaptive RL agent learning")

-- ═══════════════════════════════════════════════════════════════════════
-- INPUT
-- ═══════════════════════════════════════════════════════════════════════

@source(type='http', receiver.url='http://0.0.0.0:8282/occupancy/stream',
        @map(type='json'))
define stream OccupancyEventStream (
    room_id string,
    occupancy int,
    occupancy_probability double,
    temperature double,
    timestamp string
);

-- ═══════════════════════════════════════════════════════════════════════
-- OUTPUT
-- ═══════════════════════════════════════════════════════════════════════

-- Hourly occupancy patterns per room
@sink(type='log', prefix='[OccupancyPattern]')
define stream OccupancyPatternStream (
    hour_of_day int,
    room_id string,
    avg_occupancy double,
    max_occupancy int,
    occupancy_rate double,
    sample_count long
);

-- Daily occupancy insights
@sink(type='log', prefix='[OccupancyInsight]')
define stream OccupancyInsightStream (
    date string,
    room_id string,
    peak_hour int,
    peak_occupancy double,
    total_occupied_hours double,
    avg_daily_occupancy double
);

-- ═══════════════════════════════════════════════════════════════════════
-- PROCESSING
-- ═══════════════════════════════════════════════════════════════════════

-- Query 1: Hourly occupancy aggregation (1-hour batch windows)
@info(name='HourlyOccupancyPattern')
from OccupancyEventStream#window.timeBatch(1 hour)
select
    time:extract('HOUR', timestamp) as hour_of_day,
    room_id,
    avg(convert(occupancy, 'double')) as avg_occupancy,
    max(occupancy) as max_occupancy,
    ifThenElse(count() > 0, (sum(ifThenElse(occupancy > 0, 1l, 0l)) * 100.0 / count()), 0.0) as occupancy_rate,
    count() as sample_count
group by room_id
insert into OccupancyPatternStream;

-- Query 2: Daily occupancy summary (24-hour batch windows)
@info(name='DailyOccupancyInsight')
from OccupancyPatternStream#window.timeBatch(24 hour)
select
    time:currentDate() as date,
    room_id,
    hour_of_day as peak_hour,
    max(avg_occupancy) as peak_occupancy,
    sum(ifThenElse(avg_occupancy > 0.1, 1.0, 0.0)) as total_occupied_hours,
    avg(avg_occupancy) as avg_daily_occupancy
group by room_id
insert into OccupancyInsightStream;

/*
 * WSO2 Streaming Integrator 7.0.0
 * Anomaly Detection Siddhi Application
 *
 * Real-time anomaly detection using sliding window analysis.
 * Detects: temperature spikes, stuck sensors, HVAC degradation.
 *
 * Input:  SensorDataStream
 * Output: AnomalyAlertStream (to FastAPI backend)
 */

@App:name("AnomalyDetectionApp")
@App:description("Real-time anomaly detection for Smart Building sensor data")

-- ═══════════════════════════════════════════════════════════════════════
-- INPUT
-- ═══════════════════════════════════════════════════════════════════════

@source(type='http', receiver.url='http://0.0.0.0:8281/anomaly/stream',
        @map(type='json'))
define stream SensorInputStream (
    room_id string,
    temperature double,
    humidity double,
    co2 double,
    lux double,
    timestamp string
);

-- ═══════════════════════════════════════════════════════════════════════
-- OUTPUT
-- ═══════════════════════════════════════════════════════════════════════

@sink(type='http', publisher.url='http://localhost:8000/ai/anomalies',
      @map(type='json'))
define stream AnomalyAlertStream (
    room_id string,
    anomaly_type string,
    severity string,
    description string,
    detected_at string,
    anomaly_score double
);

@sink(type='log', prefix='[AnomalyDetection]')
define stream AnomalyLogStream (
    room_id string,
    anomaly_type string,
    description string
);

-- ═══════════════════════════════════════════════════════════════════════
-- DETECTION QUERIES
-- ═══════════════════════════════════════════════════════════════════════

-- Query 1: Temperature spike detection (>5°C change in 10-min window)
@info(name='TemperatureSpikeDetection')
from SensorInputStream#window.time(10 min)
select
    room_id,
    max(temperature) - min(temperature) as temp_range,
    avg(temperature) as avg_temp,
    count() as samples
group by room_id
having temp_range > 5.0
insert into TemperatureSpikeStream;

from TemperatureSpikeStream
select
    room_id,
    'temperature_spike' as anomaly_type,
    'high' as severity,
    str:concat('Temperature changed by ', convert(temp_range, 'string'), '°C in 10 minutes') as description,
    time:currentTimestamp() as detected_at,
    ifThenElse(temp_range > 10.0, 0.95, 0.75) as anomaly_score
insert into AnomalyAlertStream;

-- Query 2: Stuck sensor detection (zero variance over 15-min window)
@info(name='StuckSensorDetection')
from SensorInputStream#window.time(15 min)
select
    room_id,
    stdDev(temperature) as temp_stddev,
    stdDev(humidity) as hum_stddev,
    count() as samples
group by room_id
having samples > 5 and temp_stddev < 0.01 and hum_stddev < 0.01
insert into StuckSensorStream;

from StuckSensorStream
select
    room_id,
    'stuck_sensor' as anomaly_type,
    'medium' as severity,
    str:concat('Sensor in room ', room_id, ' showing zero variance for 15 minutes - possible sensor failure') as description,
    time:currentTimestamp() as detected_at,
    0.85 as anomaly_score
insert into AnomalyAlertStream;

-- Query 3: High CO2 detection (>1200 ppm sustained)
@info(name='HighCO2Detection')
from SensorInputStream#window.timeBatch(5 min)
select
    room_id,
    avg(co2) as avg_co2,
    max(co2) as max_co2
group by room_id
having avg_co2 > 1200.0
insert into HighCO2Stream;

from HighCO2Stream
select
    room_id,
    'high_co2' as anomaly_type,
    'critical' as severity,
    str:concat('CO2 levels averaging ', convert(avg_co2, 'string'), ' ppm - ventilation may be insufficient') as description,
    time:currentTimestamp() as detected_at,
    0.9 as anomaly_score
insert into AnomalyAlertStream;

# Copy to .env and replace every CHANGE_ME (for example with: openssl rand -base64 24).
# .env is git-ignored; never commit real values. CI and Kubernetes take these from their own secret stores.
COMPOSE_PROJECT_NAME=smartbuilding
COMPOSE_PROFILES=simulator,monitoring

# Listen address of the web UIs and APIs. 127.0.0.1 = this computer only; 0.0.0.0 = the LAN (put a firewall in front).
BIND_ADDR=127.0.0.1
MQTT_BIND=127.0.0.1

# PostgreSQL superuser and one password per service
POSTGRES_PASSWORD=CHANGE_ME
MLFLOW_DB_PASSWORD=CHANGE_ME
INGEST_DB_PASSWORD=CHANGE_ME
GRAFANA_DB_PASSWORD=CHANGE_ME

# MQTT users (ACL in infrastructure/mosquitto/acl): edge brain, boards, ingestion
MQTT_EDGE_PASSWORD=CHANGE_ME
MQTT_DEVICE_PASSWORD=CHANGE_ME
MQTT_INGEST_PASSWORD=CHANGE_ME

# Grafana login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Optional: enable POST /model/reload on the ML API and the admin endpoints of the edge brain
ML_ADMIN_TOKEN=
EDGE_ADMIN_TOKEN=

# Images: REGISTRY/TAG select prebuilt images (CI pushes ghcr.io/<owner>/smartbuilding/<service>:<git sha>)
REGISTRY=ghcr.io/ravindu-vs/smartbuilding
TAG=latest
# Base images (override for an offline/air-gapped mirror)
PYTHON_IMAGE=python:3.12-slim
NODE_IMAGE=node:22-bookworm-slim

# Backups (docker compose --profile backup run --rm backup)
BACKUP_DIR=./backups
BACKUP_KEEP=7

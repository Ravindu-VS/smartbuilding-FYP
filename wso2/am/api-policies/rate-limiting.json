{
  "policyName": "SmartBuildingRateLimiting",
  "description": "Rate limiting policy for Smart Building API endpoints",
  "policies": {
    "sensor_ingestion": {
      "path": "/sensors/*",
      "limit": {
        "requestCount": 1000,
        "timeUnit": "min",
        "unitTime": 1
      },
      "description": "High throughput for IoT sensor data (1000 req/min)"
    },
    "energy_endpoints": {
      "path": "/energy/*",
      "limit": {
        "requestCount": 300,
        "timeUnit": "min",
        "unitTime": 1
      },
      "description": "Standard rate for energy data queries"
    },
    "ai_endpoints": {
      "path": "/ai/*",
      "limit": {
        "requestCount": 100,
        "timeUnit": "min",
        "unitTime": 1
      },
      "description": "Rate-limited AI endpoints to prevent LLM abuse"
    },
    "optimization_endpoints": {
      "path": "/optimization/*",
      "limit": {
        "requestCount": 60,
        "timeUnit": "min",
        "unitTime": 1
      },
      "description": "Throttled optimization actions (max 1/sec)"
    },
    "auth_endpoints": {
      "path": "/auth/*",
      "limit": {
        "requestCount": 30,
        "timeUnit": "min",
        "unitTime": 1
      },
      "description": "Strict rate limit on auth to prevent brute-force"
    }
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!--
  WSO2 Micro Integrator 4.2.0
  MQTT Inbound Endpoint
  
  Subscribes to MQTT broker topic smartbuilding/sensors/#
  and routes incoming messages to SensorIngestionSequence.
  
  Prerequisites:
    - Eclipse Mosquitto MQTT Broker running on port 1883
    - ESP32 devices publishing to smartbuilding/sensors/{room_id}
-->
<inboundEndpoint name="MQTTSensorInbound"
                 sequence="SensorIngestionSequence"
                 onError="fault"
                 protocol="mqtt"
                 suspend="false"
                 xmlns="http://ws.apache.org/ns/synapse">
    <parameters>
        <!-- MQTT Broker Configuration -->
        <parameter name="mqtt.connection.factory">mqttConFactory</parameter>
        <parameter name="mqtt.server.host.name">localhost</parameter>
        <parameter name="mqtt.server.port">1883</parameter>
        <parameter name="mqtt.topic.name">smartbuilding/sensors/#</parameter>
        <parameter name="mqtt.subscription.qos">1</parameter>
        
        <!-- Client Configuration -->
        <parameter name="mqtt.client.id">WSO2_MI_SmartBuilding_Subscriber</parameter>
        <parameter name="mqtt.temporary.store.directory">/tmp/wso2mi/mqtt</parameter>
        
        <!-- Content Type -->
        <parameter name="content.type">application/json</parameter>
        
        <!-- Reconnection -->
        <parameter name="mqtt.reconnect.interval">5000</parameter>
        <parameter name="mqtt.session.clean">true</parameter>
    </parameters>
</inboundEndpoint>

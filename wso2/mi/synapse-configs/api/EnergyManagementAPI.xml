<?xml version="1.0" encoding="UTF-8"?>
<!--
  WSO2 Micro Integrator 4.2.0
  Energy Management REST API
  
  Proxies energy data endpoints through MI for monitoring,
  logging, and enterprise integration patterns.
-->
<api context="/smart-building/energy" name="EnergyManagementAPI" xmlns="http://ws.apache.org/ns/synapse">
    <!-- GET /smart-building/energy/current -->
    <resource methods="GET" uri-template="/current">
        <inSequence>
            <log level="custom">
                <property name="API" value="EnergyManagementAPI - GET /current"/>
            </log>
            <call>
                <endpoint key="EnergyAPIEndpoint"/>
            </call>
            <respond/>
        </inSequence>
        <faultSequence>
            <payloadFactory media-type="json">
                <format>{"error": "Energy current data unavailable", "code": 503}</format>
                <args/>
            </payloadFactory>
            <property name="HTTP_SC" value="503" scope="axis2"/>
            <respond/>
        </faultSequence>
    </resource>

    <!-- GET /smart-building/energy/prediction -->
    <resource methods="GET" uri-template="/prediction">
        <inSequence>
            <log level="custom">
                <property name="API" value="EnergyManagementAPI - GET /prediction"/>
            </log>
            <call>
                <endpoint>
                    <address uri="http://localhost:8000/energy/prediction"/>
                </endpoint>
            </call>
            <respond/>
        </inSequence>
    </resource>

    <!-- POST /smart-building/energy/optimize -->
    <resource methods="POST" uri-template="/optimize">
        <inSequence>
            <log level="custom">
                <property name="API" value="EnergyManagementAPI - POST /optimize (triggering workflow)"/>
            </log>
            <sequence key="EnergyOptimizationSequence"/>
            <respond/>
        </inSequence>
    </resource>
</api>

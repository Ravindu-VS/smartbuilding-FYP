<?xml version="1.0" encoding="UTF-8"?>
<!--
  WSO2 Micro Integrator 4.2.0
  Alert Notification Sequence
  
  Triggered when anomaly conditions are detected (high CO2, sensor drift, etc.)
-->
<sequence name="AlertNotificationSequence" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
    <log level="custom">
        <property name="ALERT" value="⚠ BUILDING ANOMALY DETECTED"/>
        <property expression="json-eval($.room_id)" name="Room"/>
        <property expression="json-eval($.co2)" name="CO2_Level"/>
    </log>

    <!-- Create alert payload -->
    <payloadFactory media-type="json">
        <format>
            {
                "alert_type": "environmental_anomaly",
                "severity": "high",
                "room_id": "$1",
                "details": {
                    "co2_level": $2,
                    "threshold": 1000,
                    "message": "CO2 levels exceeded safe threshold"
                },
                "timestamp": "$3",
                "source": "WSO2_MI_AlertSequence"
            }
        </format>
        <args>
            <arg evaluator="json" expression="$.room_id"/>
            <arg evaluator="json" expression="$.co2"/>
            <arg evaluator="xml" expression="get-property('SYSTEM_DATE', 'yyyy-MM-dd HH:mm:ss')"/>
        </args>
    </payloadFactory>

    <!-- Forward alert to FastAPI anomaly endpoint -->
    <property name="messageType" value="application/json" scope="axis2"/>
    <property name="ContentType" value="application/json" scope="axis2"/>

    <call>
        <endpoint>
            <address uri="http://localhost:8000/ai/anomalies">
                <timeout>
                    <duration>3000</duration>
                    <responseAction>fault</responseAction>
                </timeout>
            </address>
        </endpoint>
    </call>

    <log level="custom">
        <property name="ALERT" value="Alert notification forwarded to backend"/>
    </log>
</sequence>
